{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gladly.local/path-a/demo-spec.schema.json",
  "title": "Path A Demo Spec",
  "description": "Day-one contract: scrape pack → Script JSON → Screens cw- twin on site plate. Fail-closed: no imageUrl → omit ProductCard. Production ProductCard SoT has no price; displayPrice is film-only optional.",
  "type": "object",
  "additionalProperties": false,
  "required": ["prospect", "header", "turns", "products", "softClose", "plate"],
  "properties": {
    "prospect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "domain"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "domain": { "type": "string", "minLength": 1 },
        "accent": {
          "description": "Optional. Omit → stock green header. Known: green | purple, or CSS color.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "header": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "subtitle"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string", "minLength": 1 }
      }
    },
    "turns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["i", "role", "text"],
        "properties": {
          "i": { "type": "integer", "minimum": 1 },
          "role": { "type": "string", "enum": ["shopper", "agent"] },
          "text": { "type": "string", "minLength": 1 },
          "beat": { "type": "string", "minLength": 1 }
        }
      }
    },
    "products": {
      "type": "array",
      "description": "ProductList source. Renderer MUST omit any item lacking a usable imageUrl (fail-closed).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "imageUrl", "pageUrl"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "imageUrl": {
            "type": "string",
            "minLength": 1,
            "description": "Required to render. Empty/missing → omit card (fail-closed)."
          },
          "pageUrl": { "type": "string", "minLength": 1 },
          "displayPrice": {
            "type": "string",
            "description": "FILM-ONLY optional. Production ProductCard SoT has no price field. Do not treat as production schema."
          }
        }
      }
    },
    "softClose": {
      "type": "boolean",
      "description": "true = soft-close honesty: point-only ATC; no Added/Pay UI."
    },
    "plate": {
      "type": "object",
      "additionalProperties": false,
      "description": "Provide screenshotUrl XOR path (at least one).",
      "properties": {
        "screenshotUrl": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 }
      },
      "anyOf": [
        { "required": ["screenshotUrl"] },
        { "required": ["path"] }
      ]
    }
  }
}
